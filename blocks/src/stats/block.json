{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundnxt/stats",
  "version": "2.0.0",
  "title": "Metrics & KPI Grid",
  "category": "foundnxt",
  "description": "Showcase 2, 3, or 4 high-impact metrics with badges and source attribution.",
  "keywords": [
    "foundnxt",
    "stats",
    "kpi",
    "metrics",
    "numbers",
    "data"
  ],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "inserter": true
  },
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "source": {
      "type": "string",
      "default": ""
    },
    "stat1": { "type": "string", "default": "90%" },
    "label1": { "type": "string", "default": "Startup Failure Rate" },
    "change1": { "type": "string", "default": "" },
    "stat2": { "type": "string", "default": "3.4x" },
    "label2": { "type": "string", "default": "Series A Multiple" },
    "change2": { "type": "string", "default": "" },
    "stat3": { "type": "string", "default": "₹50Cr" },
    "label3": { "type": "string", "default": "Median Round Sizing" },
    "change3": { "type": "string", "default": "" },
    "stat4": { "type": "string", "default": "" },
    "label4": { "type": "string", "default": "" },
    "change4": { "type": "string", "default": "" }
  },
  "render": "file:./render.php"
}