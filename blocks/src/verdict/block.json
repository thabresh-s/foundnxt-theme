{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundnxt/verdict",
  "version": "2.0.0",
  "title": "Executive Verdict & Scorecard",
  "category": "foundnxt",
  "description": "Product review summary with numerical rating score, status badge, and conclusion.",
  "keywords": [
    "foundnxt",
    "verdict",
    "score",
    "review",
    "rating",
    "evaluation"
  ],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "inserter": true
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Executive Verdict"
    },
    "text": {
      "type": "string",
      "default": "A standout solution for high-growth tech firms requiring automated multi-tier architecture, defensible margin expansion, and enterprise security compliance."
    },
    "score": {
      "type": "string",
      "default": "9.2 / 10"
    },
    "badge": {
      "type": "string",
      "default": "Editor’s Choice"
    },
    "badgeColor": {
      "type": "string",
      "default": "brand"
    }
  },
  "render": "file:./render.php"
}