{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundnxt/highlight",
  "version": "1.0.0",
  "title": "Highlight Strip (Deprecated)",
  "category": "foundnxt",
  "description": "Legacy highlight strip - use FoundNXT Callout Note instead",
  "keywords": [
    "foundnxt",
    "highlight"
  ],
  "supports": {
    "inserter": false,
    "html": false,
    "align": false,
    "color": {
      "background": false,
      "text": false
    },
    "spacing": false,
    "typography": false
  },
  "attributes": {
    "content": {
      "type": "string",
      "default": "🔑 Quick fact: Add a standout single-line stat or fact here."
    }
  },
  "render": "file:./render.php"
}