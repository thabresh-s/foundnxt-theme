{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundnxt/big-number",
  "version": "2.0.0",
  "title": "Big Number",
  "category": "foundnxt",
  "description": "Giant hero stat spotlight with badge, narrative context, and source",
  "icon": "calculator",
  "keywords": [
    "foundnxt",
    "big-number",
    "stat",
    "metric",
    "kpi"
  ],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "color": {
      "background": false,
      "text": false
    },
    "spacing": false,
    "typography": false
  },
  "attributes": {
    "figure": {
      "type": "string",
      "default": "₹8.4L Cr"
    },
    "context": {
      "type": "string",
      "default": "Total venture funding raised by high-growth startups — representing a 3x leap over historical baselines."
    },
    "label": {
      "type": "string",
      "default": "Market Benchmark"
    },
    "badge": {
      "type": "string",
      "default": "+145% YoY"
    },
    "source": {
      "type": "string",
      "default": "FoundNXT Research & Ecosystem Index"
    }
  },
  "render": "file:./render.php"
}