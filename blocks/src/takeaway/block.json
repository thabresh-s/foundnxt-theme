{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundnxt/takeaway",
  "version": "2.0.0",
  "title": "Key Takeaway",
  "category": "foundnxt",
  "description": "High-impact summary card for core editorial takeaways and key insights.",
  "keywords": [
    "foundnxt",
    "takeaway",
    "insight",
    "summary",
    "highlight"
  ],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "inserter": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Key Takeaway"
    },
    "content": {
      "type": "string",
      "default": "Summarise the core insight or actionable takeaway from this section."
    }
  },
  "render": "file:./render.php"
}