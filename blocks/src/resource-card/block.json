{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundnxt/resource-card",
  "version": "2.0.0",
  "title": "Download & Resource Card",
  "category": "foundnxt",
  "description": "Download card for founder templates, financial models, PDF guides, and spreadsheets.",
  "keywords": [
    "foundnxt",
    "resource",
    "download",
    "template",
    "pdf",
    "excel"
  ],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "inserter": true
  },
  "attributes": {
    "icon": {
      "type": "string",
      "default": "📊"
    },
    "title": {
      "type": "string",
      "default": "SaaS Valuation & Unit Economics Financial Model"
    },
    "meta": {
      "type": "string",
      "default": "Excel Spreadsheet · Free Resource"
    },
    "desc": {
      "type": "string",
      "default": "Fully customizable 3-statement model including cohort retention curves and CAC payback tables."
    },
    "btnText": {
      "type": "string",
      "default": "Download Template →"
    },
    "btnUrl": {
      "type": "string",
      "default": "#"
    }
  },
  "render": "file:./render.php"
}